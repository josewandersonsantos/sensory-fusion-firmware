{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cargo",
			"command": "build",
			"problemMatcher": [
				"$rustc"
			],
			"group": "build",
			"label": "rust: cargo build[MCU]"
		},
		{
			"label": "Cargo Build",
			"group": "build",
			"type": "shell",
			"command": "cargo",
			"args": 
			[ 
				"build" ,
			],
			"problemMatcher":
			[
				"$rustc"
			]
		},
		{
			"label": "Cargo Flash",
			"group": "build",
			"type": "shell",
			"command": "cargo",
